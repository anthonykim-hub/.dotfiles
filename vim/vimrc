set nocompatible
filetype off

" Install vim-plug if not found
set rtp+=~/.config/vim-local
if empty(glob("~/.config/vim-local/autoload/plug.vim"))
    silent !curl -fLo ~/.config/vim-local/autoload/plug.vim --create-dirs
      \ https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim
endif

" Run PlugInstall if there are missing plugins
autocmd VimEnter * if len(filter(values(g:plugs), '!isdirectory(v:val.dir)'))
  \| PlugInstall --sync | source $MYVIMRC
\| endif

call plug#begin("~/.config/vim-local/plugged")
Plug 'airblade/vim-gitgutter'
Plug 'dbakker/vim-paragraph-motion'
Plug 'dracula/vim', { 'as': 'dracula' }
let g:dracula_bold = 0
let g:dracula_italic = 0
Plug 'farmergreg/vim-lastplace'
Plug 'inkarkat/vim-ReplaceWithRegister'
Plug 'jeffkreeftmeijer/vim-numbertoggle'
Plug 'kshenoy/vim-signature'
Plug 'machakann/vim-highlightedyank'
let g:highlightedyank_highlight_duration = 200
let g:highlightedyank_highlight_in_visual = 200
Plug 'ojroques/vim-oscyank', {'branch': 'main'}
Plug 'sheerun/vim-polyglot'
Plug 'tpope/vim-commentary'
Plug 'tpope/vim-endwise'
Plug 'tpope/vim-repeat'
Plug 'tpope/vim-rsi'
Plug 'tpope/vim-sleuth'
Plug 'tpope/vim-speeddating'
Plug 'tpope/vim-surround'
Plug 'wellle/targets.vim'
call plug#end()

filetype plugin indent on
syntax on
packadd! matchit
let mapleader=" "
set autoindent
set autoread
set background=dark
set backspace=indent,eol,start
set backup
set backupdir=~/tmp//
set belloff=all
set clipboard=unnamedplus,unnamed
set cmdheight=2
set complete+=kspell ":help cpt
set display=lastline,truncate
set encoding=utf-8
set expandtab
set foldcolumn=2
set formatoptions=croqlj
set hidden
set hlsearch
set history=1000
set ignorecase
set incsearch
set infercase
set nolangremap
set laststatus=2
set list
set listchars=tab:»·,trail:·
set mouse=
set nrformats-=octal
set number relativenumber
set omnifunc=syntaxcomplete#Complete
set pastetoggle=<F12>
set ruler
set scrolloff=1
set sessionoptions-=options
set shiftwidth=4
set showmode
set showtabline=2
set sidescroll=1
set sidescrolloff=2
set signcolumn=yes
set smartcase
set smartindent
set smarttab
set softtabstop=4
set tabpagemax=50
set tabstop=4
set termguicolors
set textwidth=80
set ttimeout
set ttimeoutlen=100
set undofile
set undodir=~/tmp//
set viewoptions-=options
set viminfo=!,'1000,/100,:100,<1000,f1,h,s1000
set viminfofile=~/tmp/.viminfo
set wildmenu

map Q                     gq
nnoremap <silent> <C-L>   :nohlsearch<CR><C-L>
inoremap <C-U>            <C-G>u<C-U>
nnoremap U                :redo<CR>
nnoremap Y                y$
nnoremap /                /\v
nnoremap ?                ?\v
vnoremap <                <gv
vnoremap >                >gv
inoremap <silent> d^*     ============<C-R>=strftime("%Y-%m-%d %H:%M:%S")<CR>============<CR>
inoremap <silent> l^*     -------------------------------------------<CR>
iab s^*                   μs
iab m^*                   μm

" plugin related
if exists('$SSH_TTY') || exists("$WSLENV")
  set clipboard=
  nmap <leader>y          <Plug>OSCYankOperator
  nmap <leader>yy         <leader>y_
  nmap <leader>Y          <leader>y$
  vmap <leader>y          <Plug>OSCYankVisual
else
  nnoremap <leader>y      "+y
  nnoremap <leader>yy     "+y_
  nnoremap <leader>Y      "+y$
  vnoremap <leader>y      "+y
endif

colorscheme dracula
highlight clear foldcolumn
highlight clear signcolumn
highlight clear Tablinefill
set statusline=%<%f%=\ [%1*%M%*%{','.&fileformat}%R%Y]\ [%6l,%4c%V]\ %3b\ 0x%02Bh\ %P
" vim:ft=vim:tw=0:sw=2:ts=2:sts=2:nowrap
